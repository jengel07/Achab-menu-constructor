# ============================================================
# DATABASE — PostgreSQL (Supabase)
# Для миграций (prisma db push / migrate) — прямое подключение порт 5432
# Для runtime (PrismaClient) — можно использовать pooler порт 6543
# ============================================================

# Прямое подключение (для миграций и db push)
DIRECT_URL=postgresql://myuser:mypassword@localhost:5432/mydb?schema=public

# Pooled подключение (для runtime)
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb?schema=public

