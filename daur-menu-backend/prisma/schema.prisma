// daur-menu-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String?
  menus      Menu[]
  staff      Staff[]
  orders     Order[]
  dishes     Dish[]     // Связь с блюдами ресторана
  categories Category[] // Связь с категориями
  banners    PromotionBanner[]
  ordersThreadId String?
  waitersThreadId String?
  reviewsThreadId String?
}

model Menu {
  id               String     @id @default(uuid())
  info             String?    @db.Text
  items            String?    @db.Text // Можно оставить как резерв или для метаданных
  cats             String?    @db.Text
  general_settings String?    @db.Text
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  name         String
  orderIndex   Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]     // Связь: блюда в этой категории
}

model Dish {
  id           String      @id @default(uuid())
  name         String
  price        Float
  priceGlass   Float?
  priceGlassLabel String?
  priceBottle  Float?
  priceBottleLabel String?
  description  String?     @db.Text
  image        String?
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  restaurantId String      
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade) 
  isAvailable  Boolean     @default(true)
  noNuts       Boolean     @default(false)
  noLactose    Boolean     @default(false)
  noGluten     Boolean     @default(false)
  vegetarian   Boolean     @default(false)
  vegan        Boolean     @default(false)
  tags         DishTag[]
  orderItems   OrderItem[]
  modifiers   Json?
}

model Tag {
  id     String    @id @default(uuid())
  name   String    @unique
  dishes DishTag[]
}

model DishTag {
  dishId String
  tagId  String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dishId, tagId])
}

model Staff {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  role         String     @default("Администратор")
  status       String     @default("Активен")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String
  type          String
  status        String      @default("new")
  tableNumber   String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  address       String?
  scheduledTime String?
  comment       String?
  rejectionNote String?
  totalPrice    Float
  rating        Int?
  feedback      String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt @default(now())
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId   String?
  dish     Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)
  name     String
  price    Float
  quantity Int
}
model PromotionBanner {
  id           String     @id @default(uuid())
  imageUrl     String     @db.Text
  isActive     Boolean    @default(true)
  targetItemId String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
