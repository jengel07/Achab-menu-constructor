generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String?
  ordersThreadId  String?
  reviewsThreadId String?
  waitersThreadId String?
  ownerTelegramId String?
  paidUntil       DateTime?
  paymentStatus   String            @default("trial")
  tariffId        String?
  createdAt       DateTime          @default(now())
  status          String            @default("TRIAL")
  trialEndsAt     DateTime?
  categories      Category[]
  dishes          Dish[]
  menus           Menu[]
  orders          Order[]
  PaymentRequest  PaymentRequest[]
  banners         PromotionBanner[]
  Tariff          Tariff?           @relation(fields: [tariffId], references: [id])
  staff           Staff[]
}

model Menu {
  id               String     @id @default(uuid())
  info             String?
  items            String?
  cats             String?
  general_settings String?
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  name         String
  orderIndex   Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]
}

model Dish {
  id               String      @id @default(uuid())
  name             String
  price            Float
  priceGlass       Float?
  priceGlassLabel  String?
  priceBottle      Float?
  priceBottleLabel String?
  description      String?
  image            String?
  categoryId       String?
  restaurantId     String
  isAvailable      Boolean     @default(true)
  noNuts           Boolean     @default(false)
  noLactose        Boolean     @default(false)
  noGluten         Boolean     @default(false)
  vegan            Boolean     @default(false)
  vegetarian       Boolean     @default(false)
  modifiers        Json?
  category         Category?   @relation(fields: [categoryId], references: [id])
  restaurant       Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tags             DishTag[]
  orderItems       OrderItem[]
}

model Tag {
  id     String    @id @default(uuid())
  name   String    @unique
  dishes DishTag[]
}

model DishTag {
  dishId String
  tagId  String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dishId, tagId])
}

model Staff {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  role         String     @default("РђРґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂ")
  status       String     @default("РђРєС‚РёРІРµРЅ")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String
  type          String
  status        String      @default("new")
  tableNumber   String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  address       String?
  scheduledTime String?
  comment       String?
  rejectionNote String?
  totalPrice    Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  restaurantId  String
  feedback      String?
  rating        Int?
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  dishId   String?
  name     String
  price    Float
  quantity Int
  dish     Dish?   @relation(fields: [dishId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PromotionBanner {
  id           String     @id @default(uuid())
  imageUrl     String
  isActive     Boolean    @default(true)
  targetItemId String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id           String     @id
  restaurantId String
  tariffId     String
  amount       Float
  months       Int
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  Tariff       Tariff     @relation(fields: [tariffId], references: [id])
}

model Tariff {
  id                 String           @id
  name               String
  pricePerMonth      Float
  pricePer6Months    Float?
  pricePerYear       Float?
  features           String?
  paymentInstruction String?
  PaymentRequest     PaymentRequest[]
  Restaurant         Restaurant[]
}
